# Copy to .env and fill every secret in. Values are intentionally blank: services
# fail to start when a required secret is missing rather than falling back to a
# shared committed default (S1 / P0-SEC-02).
# Generate one with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

APP_NAME="Kinetix Review Service"
APP_ENV="development"
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="UTC"
APP_URL="http://localhost:8002"

PORT=8002

DB_CONNECTION="pgsql"
DB_HOST="localhost"
DB_PORT=5436
DB_DATABASE="kinetix_review_dev"
DB_USERNAME=kinetix_review_app
DB_PASSWORD=

ORDER_SERVICE_GRPC_URL="localhost:50055"
IDENTITY_SERVICE_GRPC_URL="localhost:50052"
