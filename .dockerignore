# Keep secrets and local state out of the build context (S1 / P0-IMG-01).
# Every Dockerfile here used COPY . . with no .dockerignore, so .env — which now holds
# freshly rotated secrets — and the whole .git history were baked into distributable
# image layers. `docker history` exposes them even if a later layer deletes the file.

.env
.env.*
!.env.example
*.pem
*.key

.git
.gitignore
.github
.gitlab-ci.yml

Dockerfile
docker-compose*.yml
.dockerignore

*.md
docs/

# NOTE: vendor/ is deliberately NOT ignored yet. It is untracked, and the Dockerfile
# never actually installs dependencies — `composer install` runs without composer present
# and its failure is swallowed by `2>/dev/null || true`. The image works only because the
# local vendor/ is copied in. Excluding it here would produce an empty image. Fix the
# build first (install composer, drop the `|| true`), then add vendor/ to this file.
node_modules/
tests/
storage/logs/
storage/framework/cache/
.phpunit.result.cache

# Generated state, never source. bootstrap/cache/*.php is written by `artisan package:discover`
# on the HOST, where dev dependencies are installed. Copied into a --no-dev build it names
# providers that do not exist there (Laravel\Pail\PailServiceProvider), and every artisan
# command in the image dies on a class-not-found. The image regenerates these itself.
bootstrap/cache/*.php
storage/framework/cache/
storage/logs/

# vendor/ must come from the composer stage, never from the host. A host vendor/ is installed
# WITH dev dependencies, so copying it over a --no-dev install leaves installed.json claiming
# laravel/pail is present while --classmap-authoritative omits it: every artisan command then
# dies on "Class Laravel\Pail\PailServiceProvider not found" with the files sitting on disk.
vendor/

# The frankenphp binary that `octane:install` downloads for local development — 161 MB of a
# server the image already gets from its base layer. Copying it in would ship two copies of
# FrankenPHP and inflate the build context for nothing.
frankenphp
