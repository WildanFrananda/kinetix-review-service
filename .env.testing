# Values for the test suite only. Nothing here reaches a deployed environment: `phpunit.xml`
# already pins the connection to a throwaway Postgres test database and the JWKS URL to one that
# is never fetched, and this file exists so Laravel's dotenv has something to read — without it
# every single test emits a `file_get_contents(.env)` warning, and twenty warnings are exactly
# the noise a real one hides in.
#
# APP_KEY is a fixed, published, deliberately-worthless value. It encrypts nothing the suite keeps.
# It is not the deployed key, which lives in SOPS and is injected as an environment variable.
APP_NAME=Kinetix
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://localhost
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kinetix_review_test
DB_USERNAME=ci
DB_PASSWORD=ci-ephemeral-not-a-deployed-credential
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix
IDENTITY_JWKS_URL=http://identity.test/.well-known/jwks.json
ORDER_SERVICE_GRPC_URL=order.test:50055
